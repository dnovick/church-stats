# Copy to .env (gitignored) and fill in your key. Only needed for `--classify`.
# This is scoped to church-stats only: it's loaded by the Python process when
# `church-stats scan --classify` runs, never exported into your shell, so it
# has no effect on other tools (e.g. Claude Code) that also read
# ANTHROPIC_API_KEY from the environment.
ANTHROPIC_API_KEY=
